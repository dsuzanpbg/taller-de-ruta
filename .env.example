# ---------------------------------------------------------------------------
# Variables de entorno de la tienda
# Copia este archivo como .env.local y llena los valores reales.
# .env.local NUNCA se sube al repositorio.
# ---------------------------------------------------------------------------

# URL publica del sitio. En local usa http://localhost:3000
# En produccion usa tu dominio real, sin diagonal al final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mercado Pago -----------------------------------------------------------
# Se obtiene en https://www.mercadopago.com.mx/developers/panel/app
# Empieza con TEST- para pruebas y APP_USR- para produccion.
# Sin esta variable la tienda funciona completa pero el checkout muestra
# un aviso de "falta configurar el pago" en lugar de cobrar.
MERCADOPAGO_ACCESS_TOKEN=

# --- Correo de pedidos (opcional) -------------------------------------------
# Si no se configura, los pedidos solo se registran en el log del servidor.
ORDER_NOTIFICATION_EMAIL=

# --- Datos de la tienda -----------------------------------------------------
# Se muestran al cliente en las paginas legales y de contacto.
NEXT_PUBLIC_STORE_EMAIL=hola@tallerdelruta.mx
NEXT_PUBLIC_STORE_WHATSAPP=+52 000 000 0000
NEXT_PUBLIC_STORE_WHATSAPP_LINK=https://wa.me/520000000000
